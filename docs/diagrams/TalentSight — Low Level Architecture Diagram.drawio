190.0" height="36.0" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b style=&quot;font-size:14px&quot;&gt;Background runs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3B4A40&quot;&gt;progress polled every 2 s;&lt;br&gt;a half-finished run is&lt;br&gt;marked interrupted&lt;br&gt;at restart (N4)&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#D3EBDB;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacing=4;fontColor=#111111;fontSize=14;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="60.0" y="552.0" width="190.0" height="112.0" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b style=&quot;font-size:14px&quot;&gt;JSON logs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3B4A40&quot;&gt;fixed safe fields; no&lt;br&gt;names, CV text or&lt;br&gt;prompts (N22)&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#D3EBDB;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacing=4;fontColor=#111111;fontSize=14;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="60.0" y="676.0" width="190.0" height="92.0" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b style=&quot;font-size:14px&quot;&gt;Error middleware&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3B4A40&quot;&gt;plain message, no&lt;br&gt;stack trace or path&lt;br&gt;(N12)&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#D3EBDB;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacing=4;fontColor=#111111;fontSize=14;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="60.0" y="780.0" width="190.0" height="92.0" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b style=&quot;font-size:14px&quot;&gt;Startup sync&lt;/b&gt;&l