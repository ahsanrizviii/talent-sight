# Copy this file to .env and fill it in. Lines marked "required" must be set before the first start.

# ---- Database (required). Set the password BEFORE the first start: it cannot change later. ----
POSTGRES_USER=talentsight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=talentsight

# ---- Login (required). JWT_SECRET: a long random string. ----
JWT_SECRET=change-me
JWT_MINUTES=480
# The first hiring-team account, created at startup
SEED_INTERVIEWER_EMAIL=admin@talentsight.com
SEED_INTERVIEWER_PASSWORD=change-me

# ---- Language model (required): a Groq API key from console.groq.com ----
GROQ_API_KEY=
# Every Groq model has its own free limits, so the work is spread over two models.
# LLM_MODEL is the default (JD chat, Interview Assistant, e-mail wording). Empty overrides use LLM_MODEL.
LLM_MODEL=openai/gpt-oss-120b
# CV screening and Litmus (Litmus must use the same model as screening: it tests that scorer)
SCREENING_MODEL=openai/gpt-oss-120b
# Interview answer analysis
EVALUATION_MODEL=openai/gpt-oss-120b
# Report, CV claim check, interview score and interview quality: summaries of work already scored
ASSESSMENT_MODEL=openai/gpt-oss-20b
# The AI writes the wording of invitation e-mails (the time and link are always filled in by code). false = fixed wording.
AI_MAIL=true

# Address shown on public job posts
CAREERS_EMAIL=careers@talentsight.local

# ---- Video (required) ----
# Works as is with the LiveKit container from docker-compose (one computer, two browser windows).
# For a candidate on another device, use a hosted LiveKit project: LIVEKIT_URL=wss://<project>.livekit.cloud,
# LIVEKIT_SERVER_URL=https://<project>.livekit.cloud, and that project's key and secret.
LIVEKIT_API_KEY=talentsight-dev
LIVEKIT_API_SECRET=change-me-to-a-random-string-of-32-plus-characters
# Address the BROWSER uses to reach LiveKit, and the address the API container uses.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_SERVER_URL=http://livekit:7880

# ---- Live transcript: an AssemblyAI API key. Empty = interviews are not transcribed. ----
ASSEMBLYAI_API_KEY=
STT_MODEL=universal-3-6-pro

# ---- Google (optional): job posts on Blogger, interview calendar entries and Google Form import ----
# One OAuth client and one refresh token for the Google account that owns the blog, calendar and form.
# Empty BLOGGER_BLOG_ID = job posts are not published.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
BLOGGER_BLOG_ID=
BLOGGER_BLOG_URL=

# ---- CV intake ----
CV_MAX_MB=5
# Google Form applications (optional): ID from the form's edit link, URL from its share link,
# and the "Job code" question's entry.<number> from a pre-filled link.
GOOGLE_FORM_ID=
GOOGLE_FORM_URL=
GOOGLE_FORM_JOB_FIELD=

# ---- E-mail: invitations go to the candidate's real address through your mail server ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address and
#        SMTP_PASSWORD=a 16-letter App Password (Google account > Security > App passwords).
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587.
# Leave SMTP_HOST empty to switch e-mail off (the interviewer copies the link by hand).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Empty = the company name from the set-up and the SMTP_USER address
MAIL_FROM=

# ---- Google Calendar: every scheduled interview is added to this calendar ----
# primary = the calendar of the Google account the GOOGLE_REFRESH_TOKEN belongs to. Empty = off.
# The refresh token must include the calendar.events permission.
GOOGLE_CALENDAR_ID=

# ---- Interview schedule: fixed for every interview (1 hour, these hours, Monday to Friday) ----
# Saturday and Sunday are the weekend. Public holidays come from the PDF in api/knowledge/holidays/.
INTERVIEW_MINUTES=60
INTERVIEW_GAP_MINUTES=15
INTERVIEW_WINDOWS=09:00-12:00,14:00-17:00
WORK_DAYS=Mon,Tue,Wed,Thu,Fri
# Time zone shown in e-mails, in minutes from UTC (360 = UTC+06:00, Dhaka)
INTERVIEW_UTC_OFFSET_MINUTES=360

# The address candidates open. Must be a public https address for links to work on other devices.
PUBLIC_BASE_URL=http://localhost:8080

# ---- Who may sign up ----
# Empty SIGNUP_CODE = sign-up is off; only the seeded account can log in.
# SIGNUP_EMAIL_DOMAINS: optional, e.g. bjitgroup.com, so only those addresses may sign up.
COMPANY_NAME=TalentSight
SIGNUP_CODE=
SIGNUP_EMAIL_DOMAINS=
# Identity check (F7): face templates are deleted after this many days
BIOMETRIC_RETENTION_DAYS=60

# ---- Litmus (F11) ----
# Groq list prices in US dollars per million tokens, used to show what a check cost.
LLM_PRICE_INPUT_PER_MILLION=0.15
LLM_PRICE_OUTPUT_PER_MILLION=0.60
# How many of a job's top candidates "Check the shortlist" checks in one go.
LITMUS_SHORTLIST_SIZE=5