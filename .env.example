# Address the BROWSER uses to reach LiveKit, and the address the API container uses.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_SERVER_URL=http://livekit:7880

# ---- E-mail: invitations go to the candidate's real address through your mail server ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address and
#        SMTP_PASSWORD=a 16-letter App Password (Google account > Security > App passwords).
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587.
# Leave SMTP_HOST empty to switch e-mail off (the interviewer copies the link by hand).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# The address candidates open. Must be a public https address for links to work on other devices.
PUBLIC_BASE_URL=http://localhost:8080

# ---- Who may sign up ----
COMPANY_NAME=TalentSight
SIGNUP_CODE=
SIGNUP_EMAIL_DOMAINS=
